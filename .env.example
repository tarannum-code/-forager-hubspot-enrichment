# Copy to .env and fill in. Never commit .env.

# --- General ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Forager (app.forager.ai -> Settings -> API) ----------------------------
FORAGER_API_KEY=
# Numeric account id used in every API path. `python -m app.cli check` prints it.
FORAGER_ACCOUNT_ID=
FORAGER_CACHE_ENABLED=true
FORAGER_CACHE_DIR=.cache/forager
# Credits a single CLI run may spend. 0 = paid calls are refused unless --max-credits is passed.
FORAGER_MAX_CREDITS_PER_RUN=0
# Never let the account balance drop below this many credits.
FORAGER_MIN_BALANCE_RESERVE=0

# --- HubSpot (Development -> Legacy apps -> your private app) -----------------
# Auth tab -> "Access token"
HUBSPOT_ACCESS_TOKEN=
# Auth tab -> "Client secret" (used to verify webhook signatures)
HUBSPOT_CLIENT_SECRET=
HUBSPOT_API_VERSION=2026-09

# Public URL HubSpot calls, e.g. https://your-app.up.railway.app (no trailing slash).
# Used to rebuild the exact signed URL when running behind a proxy.
PUBLIC_BASE_URL=

# --- Contact discovery: job-title filter (comma-separated keywords) ----------
CONTACT_TITLES=Chief,VP,Vice President,Head of,Director,Founder
CONTACT_TITLE_EXCLUDES=Intern,Assistant,Associate Director,Former

# --- Webhook automation cost controls -----------------------------------------
WEBHOOK_ENRICHMENT_ENABLED=true
WEBHOOK_MAX_CREDITS_PER_EVENT=25
WEBHOOK_MAX_NEW_CONTACTS=2
WEBHOOK_LOOKUP_WORK_EMAIL=true
WEBHOOK_LOOKUP_PERSONAL_EMAIL=false
WEBHOOK_LOOKUP_PHONE=false
WEBHOOK_WORKER_CONCURRENCY=1
